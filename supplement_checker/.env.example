# Copy to .env for local development (never commit real secrets).

# Persistence
SUPPLEMENT_DB_PATH=./supplement_checker/data/profiles.db
SUPPLEMENT_OBJECT_ROOT=./supplement_checker/data/objects

# Auth (set false for real login flows)
SUPPLEMENT_AUTH_DISABLED=false
SUPPLEMENT_SESSION_DAYS=14

# Vision OCR: demo | openai | anthropic
SUPPLEMENT_OCR_MODE=demo
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-20250514

# PubMed / NCBI (recommended)
NCBI_EMAIL=you@example.com
NCBI_API_KEY=
NCBI_TOOL=supplement-research-platform
SUPPLEMENT_MIN_PUBMED_HITS=3

# API
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
