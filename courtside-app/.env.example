# Optional. Used at build time to make Open Graph / Twitter image URLs absolute.
# Social crawlers require absolute URLs.
#
# GitHub Pages example (after enabling Pages on this repo):
#   COURTSIDE_SITE_URL=https://jrallis988.github.io/Little-Lemon/courtside
#
# Then from repo root:
#   npm run build:courtside
COURTSIDE_SITE_URL=
