# BioCross API environment
# Copy to .env for local overrides

PORT=3001
JWT_SECRET=change-me-in-production

# Leave DATABASE_URL empty to use local SQLite (./data/biocross.db)
# SQLITE_PATH=./data/biocross.db

# Production / beta — Postgres (Railway, Neon, Supabase, Render)
# DATABASE_URL=postgresql://user:pass@host:5432/biocross
