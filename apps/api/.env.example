# BioCross API environment
# Copy to .env for local overrides

PORT=3001
JWT_SECRET=change-me-in-production

# Leave DATABASE_URL empty to use local SQLite (./data/biocross.db)
# SQLITE_PATH=./data/biocross.db

# Production / beta — Postgres (Railway, Neon, Supabase, Render)
# DATABASE_URL=postgresql://user:pass@host:5432/biocross

# Password-reset email (Resend). Without RESEND_API_KEY, links are logged only.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=BioCross <noreply@yourdomain.com>
# APP_DEEP_LINK=biocross://auth/reset-password
# PUBLIC_WEB_URL=https://app.yourdomain.com

# Optional error reporting
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=beta
