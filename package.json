{
  "name": "little-lemon-transactional-security",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "dev:all": "concurrently -k -n api,web -c teal,magenta \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@stripe/react-stripe-js": "^6.11.0",
    "@stripe/stripe-js": "^9.17.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "hono": "^4.13.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
