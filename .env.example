# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Boston Children's Hospital
NEXT_PUBLIC_SITE_TAGLINE=Where the world comes for answers
# informational | staging | production
NEXT_PUBLIC_SITE_MODE=staging
NEXT_PUBLIC_SUPPORT_EMAIL=care-intake@example.com
NEXT_PUBLIC_ANALYTICS_ID=

# CMS (optional — falls back to local TypeScript content)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Intake delivery (at least one recommended for production)
INTAKE_TO_EMAIL=intake@example.com
INTAKE_FROM_EMAIL=Care Intake <onboarding@resend.dev>
RESEND_API_KEY=
INTAKE_WEBHOOK_URL=
INTAKE_WEBHOOK_SECRET=
# Optional override for local disk store
INTAKE_STORE_DIR=
