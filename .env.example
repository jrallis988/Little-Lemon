# Optional production site URL used for absolute Open Graph tags at runtime
# Example: https://your-deployed-host.example
REACT_APP_SITE_URL=

# Required for live admissions delivery (no mailto fallback)
# 1. Open the claim URL in README (Formspree → sign in → create form)
# 2. Copy only the form id after /f/ from your endpoint
# 3. Paste it below and restart npm start
REACT_APP_FORMSPREE_ID=
