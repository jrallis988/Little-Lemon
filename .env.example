# Copy to .env and fill in values.

# Production requires PostgreSQL:
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/trumprx?sslmode=require"
# Local development may use SQLite:
DATABASE_URL="file:./dev.db"

# Auth.js — required (no hardcoded fallback). Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional local seed only (never in production): creates demo@trumprx.app
# ALLOW_DEMO_SEED=true
# DEMO_SEED_PASSWORD=

TRUMPRX_BIN="610020"
TRUMPRX_PCN="TRUMPRX"
TRUMPRX_GROUP="TRXSAVE"
COUPON_TTL_HOURS="72"

# Pricing: network (contracted DB rates) or external (no silent fallback)
PRICING_PROVIDER="network"
# PRICING_API_URL="https://partner.example.com"
# PRICING_API_KEY=

# Stripe Plus membership — required for upgrades in production
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PLUS_PRICE_ID=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price alert cron: PUT /api/alerts with Authorization: Bearer …
ALERTS_CRON_SECRET=

# RESEND_API_KEY=
# RESEND_FROM_EMAIL="alerts@yourdomain.com"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER="+1…"

# SWITCH_API_URL=
# SWITCH_API_KEY=
# TELEHEALTH_PARTNER_URL=
# MAIL_ORDER_PARTNER_URL=

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Trump RX"

# ADMIN_EMAILS="ops@yourdomain.com"
