# Supabase project credentials (Auth, Postgres, Storage, Realtime, Edge Functions)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — Spotify catalog sync + future Add-to-Library OAuth (PKCE)
# Client ID is public; token exchange must live on a backend / Edge Function.
# Phase 1 Open on Spotify works via deep links without this value.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
