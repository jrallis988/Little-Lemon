# Database (enables Better Auth + Drizzle persistence)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oj_only_jokes"

# Better Auth (when DATABASE_URL is set)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Stripe (optional — demo checkout used until set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Cloudflare R2 media (optional — SVG posters used until set)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oj-media
