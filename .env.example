# Public site URL (used for sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production — session signing secret
AUTH_SECRET=

# Door / access-control token HMAC secret
ACCESS_CONTROL_SECRET=

# Optional: Google Tag Manager (loads only after cookie consent Accept)
NEXT_PUBLIC_GTM_ID=

# Optional: Stripe secret key for Checkout / Elements / PaymentIntents on join
# Without this, join uses local test authorization and still creates a membership.
STRIPE_SECRET_KEY=

# Optional: Stripe publishable key — enables Elements path in the join funnel
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: Stripe webhook signing secret for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Optional: remote club inventory endpoint (JSON array or { clubs: [...] })
# Falls back to seed clubs in lib/clubs.ts when unset or unreachable.
CLUBS_API_URL=

# Local QA only — enables shared demo password path. Ignored in production.
ALLOW_DEMO_AUTH=false

# Local QA only — return password-reset URLs in API responses (no SMTP).
EXPOSE_PASSWORD_RESET_URL=false

# Staging only — show "Screen NN" chrome in the member app.
NEXT_PUBLIC_SHOW_SCREEN_IDS=false
