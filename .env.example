# Copy to .env and fill in production values.

# Database — local SQLite or production Postgres
# DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/trumprx?sslmode=require"
DATABASE_URL="file:./dev.db"

# Auth.js — required. Production: AUTH_SECRET >= 32 chars + absolute AUTH_URL
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

TRUMPRX_BIN="610020"
TRUMPRX_PCN="TRUMPRX"
TRUMPRX_GROUP="TRXSAVE"
COUPON_TTL_HOURS="72"

# Pricing: network (built-in contracts) or external (PBM/switch HTTP client)
PRICING_PROVIDER="network"
# PRICING_API_URL="https://partner.example.com"
# PRICING_API_KEY=

# Stripe Plus membership — webhook path: /api/webhooks/stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PLUS_PRICE_ID=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price alert cron: PUT /api/alerts with Authorization: Bearer …
ALERTS_CRON_SECRET=

# Alert delivery (optional)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="alerts@yourdomain.com"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER="+1…"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Trump RX"
