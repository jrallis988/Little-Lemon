# Vibe environment variables
# Copy to `.env.local` and fill in values when connecting Supabase.
# Without these, the app runs fully in local mock-data mode.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / public key (safe for the browser; enforce RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: service role key for server-only admin tasks (NEVER expose to the client)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: override temporary platform display name
# NEXT_PUBLIC_PLATFORM_NAME=Vibe
