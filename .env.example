# Surf environment

# Desktop (preferred) — set in the OS / shell before `tauri dev` or the packaged app:
# SURF_AI_API_KEY=sk-...
# SURF_AI_PROVIDER=anthropic
# or: ANTHROPIC_API_KEY / OPENAI_API_KEY
#
# The Tauri backend reads these so keys never ship in the web bundle.

# Web/dev fallback only (Vite — prefix with VITE_). Avoid in production installs.
VITE_SURF_AI_PROVIDER=anthropic
VITE_SURF_AI_API_KEY=
# Optional model override
# VITE_SURF_AI_MODEL=claude-sonnet-4-6

# Or use Anthropic-specific alias
# VITE_ANTHROPIC_API_KEY=
