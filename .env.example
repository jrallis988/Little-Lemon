# BioCross uses a typed API client with a built-in mock server for development.
# Set EXPO_PUBLIC_API_MODE=remote and EXPO_PUBLIC_API_URL to point at production.

EXPO_PUBLIC_API_MODE=mock
# EXPO_PUBLIC_API_URL=https://api.your-backend.com

# Local beta API (from apps/api):
# EXPO_PUBLIC_API_MODE=remote
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional — wire @sentry/react-native after install:
# EXPO_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
