# Optional Formspree override. By default the inquiry form uses Formsubmit
# to seascapeinn@hotmail.com (first submit may need email confirmation).
# Create a form at https://formspree.io and paste the form id here to use it instead.
REACT_APP_FORMSPREE_ID=

# Optional analytics (loads only after cookie-consent allows analytics)
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
REACT_APP_GA_MEASUREMENT_ID=
# Or Plausible domain, e.g. seascapeinnhamptonnh.com
REACT_APP_PLAUSIBLE_DOMAIN=
