# Public site URL (used for sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Tag Manager (loads only after cookie consent Accept)
NEXT_PUBLIC_GTM_ID=

# Optional: Stripe secret key for live/test charges on /api/memberships
# Without this, join uses test authorization and still creates a membership record.
STRIPE_SECRET_KEY=

# Optional: future remote club inventory endpoint
CLUBS_API_URL=
