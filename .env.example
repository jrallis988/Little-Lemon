# Copy to .env and fill in as needed. Demo mode works with no Stripe keys.

PORT=8787
NODE_ENV=development

# SQLite path is always ./data/gateledger.sqlite (created automatically)

# Stripe — when STRIPE_SECRET_KEY is set, PaymentIntents go to Stripe live/test API
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Allow server-side pm_card_visa confirm in non-production (default true unless NODE_ENV=production)
# STRIPE_ALLOW_TEST_CONFIRM=true
