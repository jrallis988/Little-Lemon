PORT=4000
JWT_SECRET=change-me-in-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rate_my_employer
DATABASE_SSL=false

# Password reset email (pick one)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Rate My Employer <noreply@yourdomain.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Google Sign-In (Web client ID used to verify ID tokens)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Deep link / web URL used in reset emails
APP_BASE_URL=http://localhost:8081

# Force including resetToken in API responses (dev only)
# REVEAL_RESET_TOKEN=true
