{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Surf capabilities for window controls, secure store, and filter IPC",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:default",
    "store:default",
    {
      "identifier": "surf-custom-commands",
      "allow": [
        { "cmd": "check_url" },
        { "cmd": "verify_parent_pin" },
        { "cmd": "minimize_window" },
        { "cmd": "close_window" },
        { "cmd": "secure_get" },
        { "cmd": "secure_set" }
      ]
    }
  ]
}
