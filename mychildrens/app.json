{
  "expo": {
    "name": "MyChildren's",
    "slug": "mychildrens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mychildrens",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.example.mychildrens",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your chart with Face ID.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.example.mychildrens",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1F7A8C",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EE"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your chart with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
